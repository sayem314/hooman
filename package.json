{
  "name": "hooman",
  "version": "1.2.6",
  "description": "http interceptor to hoomanize cloudflare requests",
  "type": "module",
  "main": "hooman.js",
  "types": "./hooman.d.ts",
  "exports": {
    ".": {
      "types": "./hooman.d.ts",
      "default": "./hooman.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
